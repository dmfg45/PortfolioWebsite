DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio?schema=public"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Set to "true" once the app is served over HTTPS (through a TLS-terminating
# reverse proxy) so the admin session cookie gets the Secure flag. Leave
# false for local HTTP development.
COOKIE_SECURE=false

# Used only by the seed script to create the first admin user
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-password"
