# Used by docker-compose.yml when running the full stack with `docker compose up`.
JWT_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=http://localhost:8080
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Set to "true" only once you put a TLS-terminating reverse proxy in front of
# this stack (the compose file itself serves plain HTTP on :8080). Turning it
# on without HTTPS in front breaks admin login, since browsers drop Secure
# cookies sent over plain HTTP.
COOKIE_SECURE=false
